#include <windows.h>
#include "resource.h"
#include "../version.h"

IDI_PONS ICON "../../assets/pons.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "Pons.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION PONS_VERSION_MAJOR, PONS_VERSION_MINOR, PONS_VERSION_PATCH, 0
PRODUCTVERSION PONS_VERSION_MAJOR, PONS_VERSION_MINOR, PONS_VERSION_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "VitomDev"
            VALUE "FileDescription", "Pons WiFi Transfer"
            VALUE "FileVersion", PONS_VERSION_STRING
            VALUE "InternalName", "Pons"
            VALUE "LegalCopyright", "Copyright (c) 2026 VitomDev. MIT License."
            VALUE "OriginalFilename", "Pons.exe"
            VALUE "ProductName", "Pons WiFi Transfer"
            VALUE "ProductVersion", PONS_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
